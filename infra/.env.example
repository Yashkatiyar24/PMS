# Padav API configuration. Copy to .env on the server and fill in; the API refuses to start in production while
# any of the values marked (required) is missing or still a development default.

# Where people reach the app and the API
PMS_APP_URL=https://desk.example.in                 # (required) the desk app; QR codes and links point here
PMS_API_URL=https://api.example.in                  # where a browser reaches this API (equals PMS_APP_URL behind an /api rewrite)
PMS_ALLOWED_ORIGINS=https://desk.example.in         # (required) comma-separated origins allowed to call the API with a cookie
PMS_COOKIE_SECURE=true                              # (required) the site is behind HTTPS
PMS_TRUSTED_PROXIES=                                # regex of proxy addresses on public IPs whose X-Forwarded-For is honoured; private-network proxies need nothing
PMS_PORT=8080

# Secrets
PMS_SESSION_SECRET=                                 # (required) at least 32 random characters; signs file download links
PMS_ADMIN_EMAIL=                                    # first platform admin, created once on an empty database
PMS_ADMIN_PASSWORD=                                 # at least 12 characters; change it after the first sign-in

# Database: one Postgres, three roles. The owner runs migrations; the other two are what the API works as.
PMS_DB_OWNER_URL=jdbc:postgresql://db.internal:5432/pms
PMS_DB_OWNER_USER=postgres
PMS_DB_OWNER_PASSWORD=
PMS_DB_APP_URL=jdbc:postgresql://db.internal:5432/pms
PMS_DB_APP_USER=pms_app
PMS_DB_APP_PASSWORD=                                # (required) at least 16 random characters; the migration sets the role to it
PMS_DB_APP_POOL=10
PMS_DB_ADMIN_URL=jdbc:postgresql://db.internal:5432/pms
PMS_DB_ADMIN_USER=pms_admin
PMS_DB_ADMIN_PASSWORD=                              # (required) at least 16 random characters; this role reads every property
PMS_DB_ADMIN_POOL=4

# Files: ID photos, receipts, bills
PMS_STORAGE_PROVIDER=s3                             # local | s3 (local keeps files on this server's disk under PMS_STORAGE_LOCAL_DIR)
PMS_STORAGE_LOCAL_DIR=/var/lib/padav/storage
PMS_S3_ENDPOINT=
PMS_S3_REGION=ap-south-1
PMS_S3_BUCKET=
PMS_S3_ACCESS_KEY=
PMS_S3_SECRET_KEY=
PMS_S3_PATH_STYLE=false

# Messages. Login codes go by SMS and email, so both must be real providers in production.
PMS_SMS_PROVIDER=msg91                              # (required) msg91
PMS_MSG91_AUTH_KEY=
PMS_MSG91_SENDER_ID=
PMS_MSG91_OTP_TEMPLATE_ID=
PMS_EMAIL_PROVIDER=brevo                            # (required) brevo
PMS_EMAIL_FROM=Padav <no-reply@example.in>
PMS_BREVO_API_KEY=
PMS_WHATSAPP_PROVIDER=console                       # console (off) | meta
PMS_META_WA_PHONE_NUMBER_ID=
PMS_META_WA_ACCESS_TOKEN=
PMS_META_WA_API_VERSION=v21.0
PMS_PUSH_PROVIDER=console                           # console (off) | fcm
PMS_FCM_CREDENTIALS_JSON=
PMS_TEAM_ALERT_EMAIL=                               # where undeliverable-message alerts go

# Online payments
PMS_PAYMENT_PROVIDER=none                           # none | razorpay
PMS_RAZORPAY_KEY_ID=
PMS_RAZORPAY_KEY_SECRET=
PMS_RAZORPAY_WEBHOOK_SECRET=

# Misc
PMS_PDF_PROVIDER=openhtml
PMS_JOBS_ENABLED=true                               # nightly reports, retention, outbox delivery; one instance only
PMS_DEFAULT_TIMEZONE=Asia/Kolkata
PMS_LOG_LEVEL=info
PMS_DEV_OTP=                                        # never set in production
